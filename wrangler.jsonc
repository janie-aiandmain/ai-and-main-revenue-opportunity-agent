{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-and-main-revenue-opportunity-agent",
  "main": "src/demo/worker.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "account_id": "cda2ab71dd8127c8031c945a738b86e2",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "preview_urls": false,
  "vars": {
    "CRM_WRITEBACK_ENABLED": "false",
    "ENABLE_TEST_TASK_WRITES": "false",
    "ENABLE_GENERAL_EXECUTION": "false",
    "GENERAL_RELEASE_APPROVED": "false",
    "DEMO_RECOVERY_ENABLED": "false",
    "DEMO_RECOVERY_EXECUTION_ENABLED": "false",
    "DEMO_RECOVERY_FAULT_ENABLED": "false",
    "DEPLOYMENT_ENVIRONMENT": "staging",
    "CERTIFICATION_MODE": "remote-demo",
    "STAGING_ISOLATION_APPROVED": "true",
    "STAGING_PORTAL_ID": "247646122",
    "STAGING_CONTACT_ID": "582095692487",
    "AUDIT_RETENTION_DAYS": "365",
    "ACCESS_ISSUER": "https://falling-cell-9501.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "62c0aa3dd79f48d2f6f643ff077c0b4f590b1dd7665058c5e8f442e4ae112151"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DEMO_RECOVERY_LEDGER",
        "class_name": "CertificationLedger",
        "script_name": "ai-and-main-revenue-opportunity-staging"
      }
    ]
  },
  "version_metadata": {
    "binding": "RELEASE_VERSION"
  }
}
