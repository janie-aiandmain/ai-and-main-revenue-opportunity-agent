{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-and-main-revenue-opportunity-staging",
  "main": "src/staging/worker.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "staging",
    "CERTIFICATION_MODE": "remote-demo",
    "ENABLE_TEST_TASK_WRITES": "false",
    "CRM_WRITEBACK_ENABLED": "false",
    "ENABLE_GENERAL_EXECUTION": "false",
    "GENERAL_RELEASE_APPROVED": "false",
    "ACCESS_ISSUER": "https://falling-cell-9501.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "f3d28533ee59378b47a60ea0747a3e9ee6743f6c338ea859b21f371b6c1d0548",
    "STAGING_ISOLATION_APPROVED": "true",
    "STAGING_PORTAL_ID": "247646122",
    "STAGING_CONTACT_ID": "582095692487",
    "AUDIT_RETENTION_DAYS": "365",
    "DEMO_ONLY_EXECUTION_ENABLED": "false",
    "DEMO_RESPONSE_LOSS_TEST_ENABLED": "false",
    "OPERATOR_EMAIL_ENABLED": "false",
    "OPERATOR_EMAIL_PROVIDER": "resend",
    "OPERATOR_EMAIL_FROM": "alerts@aiandmain.ai",
    "OPERATOR_EMAIL_REPLY_TO": "janie@aiandmain.ai",
    "OPERATOR_EMAIL_TO": "janie@aiandmain.ai",
    "OPERATOR_CONSOLE_URL": "https://ai-and-main-revenue-opportunity-agent.ruddy4learning.workers.dev/operator"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CERTIFICATION_LEDGER",
        "class_name": "CertificationLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "certification-v1",
      "new_sqlite_classes": [
        "CertificationLedger"
      ]
    }
  ],
  "secrets": {
    "required": [
      "STAGING_HUBSPOT_READ_TOKEN",
      "STAGING_HUBSPOT_WRITE_TOKEN",
      "EVAL_OPENAI_API_KEY"
    ]
  },
  "keep_vars": true,
  "version_metadata": {
    "binding": "RELEASE_VERSION"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
