{
  "name": "ai-and-main-revenue-opportunity-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run",
    "test": "node --test tests/*.test.js",
    "regression:offline": "node scripts/regression/workflow-offline.js",
    "regression:offline:legacy": "node scripts/regression/offline.js --legacy-v0.2",
    "regression:model": "NODE_USE_ENV_PROXY=1 node scripts/regression/model.js",
    "regression:replay": "node scripts/regression/replay.js",
    "regression:findings": "NODE_USE_ENV_PROXY=1 node scripts/regression/model-findings.js",
    "regression:stability": "NODE_USE_ENV_PROXY=1 node scripts/regression/repeat-findings.js",
    "regression:review": "node scripts/regression/generate-review.js",
    "correction:replay": "node scripts/regression/correction-replay.js",
    "correction:sandbox": "node sandbox/focused-scenario.js",
    "certification:local": "node certification/local-certification.js",
    "certification:replay": "node certification/replay-fresh.js",
    "certification:check": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config wrangler.certification.jsonc",
    "certification:evidence": "node certification/package-evidence.js",
    "regression:corrected": "NODE_USE_ENV_PROXY=1 node scripts/regression/model-corrected.js",
    "integration:local": "RUN_GENERAL_CERTIFICATION=true CERTIFICATION_EVIDENCE_PATH=reports/general-worker-pipeline.json node certification/local-certification.js",
    "integration:replay": "node certification/replay-corrected.js",
    "staging:check": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config wrangler.staging.jsonc",
    "staging:configure": "node scripts/staging/configure.js",
    "staging:verify-production": "NODE_USE_ENV_PROXY=1 node scripts/staging/verify-production.js",
    "regression:diagnostic": "node scripts/regression/offline.js",
    "regression:diagnostic:report": "node scripts/regression/diagnostic-report.js",
    "review:current": "node scripts/review/demo-closeout.js --check"
  },
  "devDependencies": {
    "wrangler": "4.156.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261102.0-beta"
  }
}
